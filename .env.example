# Supabase (free tier)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Inference. Fireworks by default. Any OpenAI compatible endpoint works.
BOOTH_LLM_API_KEY=
BOOTH_LLM_BASE_URL=https://api.fireworks.ai/inference/v1
BOOTH_LLM_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

# Email (Resend free tier)
RESEND_API_KEY=
BOOTH_FROM_EMAIL=booth@yourdomain.com

# Urgent gameday texts. Optional. Twilio is prepaid, not a subscription.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Free alternative to SMS
TELEGRAM_BOT_TOKEN=

# Scheduled jobs
CRON_SECRET=

# Feature requests from inside the app
GITHUB_TOKEN=
GITHUB_REPO=yourname/booth

# Yahoo, once your API application is approved
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
